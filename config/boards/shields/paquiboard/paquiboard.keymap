#include <behaviours.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// | ESC |  F1 |  F2 |  F3 |  F4 |  F5 |  F6 |  F7 |  F8 |  F9 |  F10|  F11|  F12|  PWR|  |NUMLC|  /  |  *  |  -  |
// | FSLH|  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |MINUS|EQUAL|  DEL|  |  7  |  8  |  9  | NONE|
// | TAB |  q  |  w  |  e  |  r  |  t  |  y  |  u  |  i  |  o  |  p  |CARET|  ç  |  RET|  |  4  |  5  |  6  |  +  |
// | CAPS|  a  |  s  |  d  |  f  |  g  |  h  |  j  |  k  |  l  |  ;  |  è  |  à  |  RET|  |  1  |  2  |  3  |  RET|
// |LSHFT|  ù  |  z  |  x  |  c  |  v  |  b  |  n  |  m  |  ,  |  .  |  é  |RSHFT| NONE|  |  0  | NONE|  UP | NONE|
// | fn  |LCTRL| LALT| LCMD| NONE| NONE| NONE|SPACE| NONE| NONE| RCMD| RALT| NONE| NONE|  |  .  | LEFT| DOWN|RIGHT|
            bindings = <
   &kp ESC   &kp F1    &kp F2   &kp F3   &kp F4 &kp F5 &kp F6 &kp F7    &kp F8 &kp F9    &kp F10  &kp F11   &kp F12   &mo 1           &kp KP_NLCK &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS 
   &kp FSLH  &kp N1    &kp N2   &kp N3   &kp N4 &kp N5 &kp N6 &kp N7    &kp N8 &kp N9    &kp N0   &kp MINUS &kp EQUAL &kp DEL         &kp KP_N7   &kp KP_N8     &kp KP_N9       &none 
   &kp TAB   &kp Q     &kp W    &kp E    &kp R  &kp T  &kp Y  &kp U     &kp I  &kp O     &kp P    &kp CARET &kp C     &kp RET         &kp KP_N4   &kp KP_N5     &kp KP_N6       &kp KP_PLUS 
   &kp CAPS  &kp A     &kp S    &kp D    &kp F  &kp G  &kp H  &kp J     &kp K  &kp L     &kp SEMI &kp E     &kp A     &kp RET         &kp KP_N1   &kp KP_N2     &kp KP_N3       &kp RET 
   &kp LSHFT &kp U     &kp Z    &kp X    &kp C  &kp V  &kp B  &kp N     &kp M  &kp COMMA &kp DOT  &kp E     &mo 1     &none           &kp KP_N0   &none         &kp UP          &none 
   &mo 2     &kp LCTRL &kp LALT &kp LCMD &none  &none  &none  &kp SPACE &none  &none     &kp RCMD &kp RALT  &none     &none           &kp KP_DOT  &kp LEFT      &kp DOWN        &kp RIGHT 
            >;
        };

        bt_layer {
            bindings = <
   &none &none &none &none &none &none &none &none &none &none &none &none &none &bootloader         &none        &none        &none        &none 
   &none &none &none &none &none &none &none &none &none &none &none &none &none &none               &none        &none        &none        &none 
   &none &none &none &none &none &none &none &none &none &none &none &none &none &none               &none        &none        &none        &none 
   &none &none &none &none &none &none &none &none &none &none &none &none &none &none               &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none 
   &none &none &none &none &none &none &none &none &none &none &none &none &none &none               &none        &none        &none        &none 
   &none &none &none &none &none &none &none &none &none &none &none &none &none &none               &bt BT_CLR   &none        &none        &none 
            >;
        };
    };
};